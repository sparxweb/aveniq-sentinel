# Dataset files - NEVER commit large raw / processed datasets
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep
data/processed/*
!data/processed/README.md
!data/processed/.gitkeep
data/external/*
!data/external/README.md
!data/external/.gitkeep
# Keep sample folder tracked for demo/testing fixtures (synthetic only)
data/sample/*.parquet
data/sample/temp_*

# Model weights and artifacts (for Phase 2)
artifacts/models/*
!artifacts/models/.gitkeep
*.joblib
*.pkl
*.onnx

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# Streamlit run cache
.streamlit/secrets.toml
