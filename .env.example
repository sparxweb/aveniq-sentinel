# NeuralShield AI - Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# DO NOT store real production secrets or API keys in this template.

# Application Environment (development | testing | production)
APP_ENV=development

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# Data Storage Paths
DATA_RAW_DIR=data/raw/cic_ids2017
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLE_DIR=data/sample

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE_PATH=reports/neuralshield.log

# Processing Parameters
CHUNK_SIZE=100000
RANDOM_STATE=42
MAX_DISPLAY_ROWS=500
